<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CounterProject.Views.AddCounterPage"
             xmlns:models="clr-namespace:CounterProject.Models"
             Title="AddCounterPage">
    <VerticalStackLayout
        Spacing="20">
        <Label 
            Text="{Binding HeaderText}"
            FontSize="Large"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Editor 
            x:Name="TextEditor"
            WidthRequest="350"
            HeightRequest="50"
            Placeholder="{Binding NameTextEditorPlaceholder}"/>
        <Editor 
            x:Name="TextEditorNum"
            WidthRequest="350"
            HeightRequest="50"
            Placeholder="{Binding NumTextEditorPlaceholder}"/>
        <Button 
            x:Name="CreateCounterButton"
            WidthRequest="350"
            HeightRequest="50"
            Text="{Binding CreateCounterButtonText}"
            Clicked="Create_Counter"/>
    </VerticalStackLayout>
</ContentPage>
