<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CounterProject.Views.AddCounterPage"
             Title="AddCounterPage">
    <VerticalStackLayout>
        <Label 
            Text="Dodaj swój licznik"
            FontSize="Large"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Editor 
            x:Name="TextEditor"
            Placeholder="Wpisz swoją nazwę licznika"/>
        <Editor 
            x:Name="TextEditorNum"
            Placeholder="Wpisz początkową wartość licznika(pole może puste, wtedy początkową wartością będzie 0)"/>
        <Button 
            x:Name="CreateCounterButton"
            Text="Dodaj nowy licznik"
            Clicked="Create_Counter"/>
    </VerticalStackLayout>
</ContentPage>